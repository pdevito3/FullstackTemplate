<Project>
  <PropertyGroup>
    <!-- A warning fails the build, so warnings cannot collect. To accept a warning, add its code to NoWarn with a comment that gives the reason. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A new security advisory must not break a build that has no code change. The audit still shows it as a warning. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 reports an unused using in the build only when the project writes a documentation file. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 asks for a doc comment on each public member. Only the names that need a reason get a comment. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- CA1707 forbids underscores in names. The test names use underscores to separate the parts of a scenario. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- CS8524 asks for a discard arm in a switch over an enum that names each member. A discard hides a member that a
         switch forgets, so CS8509 can no longer fail the build when a new member is added. -->
    <NoWarn>$(NoWarn);CS8524</NoWarn>
  </PropertyGroup>

  <!-- Each C# project gets the analyzers of FullstackTemplate.SourceGenerators, so that the build refuses a string that
       breaks FSTSTR001 in each project. The other rules check only the code of the Server, so ServerRulesOff.globalconfig
       turns them off in each other project. A global config cannot turn off a generator, so ValueObjectGenerator runs in
       each project and writes code only for a class that derives from ValueObject. IsAspireProjectResource stops the
       AppHost from making the analyzer a resource.
       A file-based script under scripts/ and the analyzer project do not get the analyzer, so ScriptRawStringTests runs
       FSTSTR001 on them. -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' and '$(FileBasedProgram)' != 'true' and '$(MSBuildProjectName)' != 'FullstackTemplate.SourceGenerators'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)FullstackTemplate.SourceGenerators/FullstackTemplate.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      IsAspireProjectResource="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' and '$(FileBasedProgram)' != 'true' and '$(MSBuildProjectName)' != 'FullstackTemplate.SourceGenerators' and '$(MSBuildProjectName)' != 'FullstackTemplate.Server'">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)FullstackTemplate.SourceGenerators/ServerRulesOff.globalconfig" />
  </ItemGroup>
</Project>
