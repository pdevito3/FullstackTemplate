{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Duende": "Warning",
        "Yarp": "Warning",
        "System": "Warning",
        // The local Data Protection keys in bffdb are not encrypted at rest. Encryption is a deployment decision.
        "Microsoft.AspNetCore.DataProtection.KeyManagement.XmlKeyManager": "Error",

        // Uncomment to enable targeted debug logging:
        // "FullstackTemplate.Bff": "Debug",
        // "Duende.AccessTokenManagement": "Debug",
        // "Microsoft.AspNetCore.Authentication": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          // Shows the call site from Here() and the trace id only when the event has them
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "[{@t:HH:mm:ss} {@l:u3}]{#if SourceContext is not null} {SourceContext}{#end}{#if CallSite is not null} {CallSite}{#end}{#if @tr is not null} trace={@tr}{#end}\n      {@m}\n{#if @x is not null}{@x}\n{#end}"
          }
        }
      }
    ],
    "Properties": {
      "Environment": "Development"
    }
  }
}
