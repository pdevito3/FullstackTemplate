<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <!-- CS1573 asks for a param tag on each parameter once one parameter has a tag. A test record documents only
             the parameters whose name does not tell their meaning. -->
        <NoWarn>$(NoWarn);CS1573</NoWarn>
        <!-- The bff-tests job of CI runs this project only on a BFF change. The test job passes SkipBffTests=true. -->
        <IsTestProject Condition="'$(SkipBffTests)' == 'true'">false</IsTestProject>
        <IsTestingPlatformApplication Condition="'$(SkipBffTests)' == 'true'">false</IsTestingPlatformApplication>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
        <PackageReference Include="Testcontainers.PostgreSql" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\FullstackTemplate.Bff\FullstackTemplate.Bff.csproj" />
    </ItemGroup>

    <!-- The Postgres image tag of the app. The tests run the same version. -->
    <ItemGroup>
        <Compile Include="..\..\FullstackTemplate.AppHost\Config.cs" Link="AppHostConfig.cs" />
    </ItemGroup>

    <!-- A reference to SharedTestHelpers also brings in the Server, so the tests compile its one database helper. -->
    <ItemGroup>
        <Compile Include="..\FullstackTemplate.SharedTestHelpers\Utilities\PauseAtQuery.cs" Link="Fakes\PauseAtQuery.cs" />
    </ItemGroup>

</Project>
