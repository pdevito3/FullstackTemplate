<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <!-- CS1573 asks for a param tag on each parameter once one parameter has a tag. A test record documents only
             the parameters whose name does not tell their meaning. -->
        <NoWarn>$(NoWarn);CS1573</NoWarn>
        <!-- CS0436: the client stub below also generates the messages, with the same names as the messages of the
             Server. The compiler uses the types of this project, which is correct for a client. -->
        <NoWarn>$(NoWarn);CS0436</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
        <PackageReference Include="WebMotions.Fake.Authentication.JwtBearer" />
        <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
        <PackageReference Include="Grpc.Net.Client" />
        <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
        <PackageReference Include="ModelContextProtocol.Core" />
    </ItemGroup>

    <!-- The Server generates only the service base. A caller generates its own client from the same contract. -->
    <ItemGroup>
        <Protobuf Include="..\..\FullstackTemplate.Server\Domain\**\Grpc\v*\*.proto" GrpcServices="Client" Link="Grpc\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\FullstackTemplate.Server\FullstackTemplate.Server.csproj" />
        <ProjectReference Include="..\FullstackTemplate.SharedTestHelpers\FullstackTemplate.SharedTestHelpers.csproj" />
    </ItemGroup>

    <!-- BannedSymbols.txt bans a today that comes from the UTC date or the clock of the machine -->
    <ItemGroup>
        <AdditionalFiles Include="..\BannedSymbols.txt" />
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
