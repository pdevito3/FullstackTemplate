<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AutoBogusLifesupport" />
        <PackageReference Include="Bogus" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="Testcontainers.PostgreSql" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\FullstackTemplate.Server\FullstackTemplate.Server.csproj" />
        <ProjectReference Include="..\FullstackTemplate.EntityGraphs.Generators\FullstackTemplate.EntityGraphs.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- The Postgres image tag of the app. The tests run the same version. -->
    <ItemGroup>
        <Compile Include="..\..\FullstackTemplate.AppHost\Config.cs" Link="AppHostConfig.cs" />
    </ItemGroup>

    <!-- BannedSymbols.txt bans a today that comes from the UTC date or the clock of the machine -->
    <ItemGroup>
        <AdditionalFiles Include="..\BannedSymbols.txt" />
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
