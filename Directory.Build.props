<Project>
  <PropertyGroup>
    <!-- A warning fails the build, so warnings cannot collect. To accept a warning, add its code to NoWarn with a comment that gives the reason. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A new security advisory must not break a build that has no code change. The audit still shows it as a warning. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- CA1707 forbids underscores in names. The test names use underscores to separate the parts of a scenario. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- CS8524 asks for a discard arm in a switch over an enum that names each member. A discard hides a member that a
         switch forgets, so CS8509 can no longer fail the build when a new member is added. -->
    <NoWarn>$(NoWarn);CS8524</NoWarn>
  </PropertyGroup>
</Project>
