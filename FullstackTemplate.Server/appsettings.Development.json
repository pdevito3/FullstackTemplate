{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",

        // Uncomment to enable targeted debug logging:
        // "FullstackTemplate.Server": "Debug",
        // "Microsoft.AspNetCore.Authentication": "Debug",
        // "Microsoft.AspNetCore.Authorization": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          // Shows the call site from Here() and the trace id only when the event has them
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "[{@t:HH:mm:ss} {@l:u3}]{#if SourceContext is not null} {SourceContext}{#end}{#if CallSite is not null} {CallSite}{#end}{#if @tr is not null} trace={@tr}{#end}\n      {@m}\n{#if @x is not null}{@x}\n{#end}"
          }
        }
      }
    ],
    "Properties": {
      "Environment": "Development"
    }
  },
  "Kestrel": {
    // The ports of a run without Aspire. Aspire replaces each Url with the port of its endpoint of the same name.
    "Endpoints": {
      "http": { "Url": "http://localhost:24714" },
      "https": { "Url": "https://localhost:24713" },
      "grpc": { "Url": "http://localhost:24715" }
    }
  }
}
