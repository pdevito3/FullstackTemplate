{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Expressions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Duende": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          // An object, not a string, so that appsettings.Development.json can replace the type
          "formatter": {
            "type": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
          }
        }
      }
    ],
    // Token management logs each failed refresh as an error, also an expected invalid_grant. The refresh lock logs
    // each failed refresh with the level of its kind, so drop the duplicate.
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "EventId.Name = 'FailedToRefreshAccessToken'"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "FullstackTemplate.Bff",
      "Environment": "Production"
    }
  },
  "Bff": {
    "Session": {
      "SlidingExpiration": "14.00:00:00",
      "AbsoluteLifetime": "30.00:00:00",
      "CleanupInterval": "00:10:00"
    },
    "Refresh": {
      "LockTimeout": "00:00:10"
    }
  },
  "AllowedHosts": "*"
}
