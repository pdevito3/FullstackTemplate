<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <PackageVersion Include="Labcoat.Aspire.Hosting" Version="1.1.2" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.1" />
    <!-- Entity Framework -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Distributed Locking -->
    <PackageVersion Include="DistributedLock.Postgres" Version="1.2.1" />
    <!-- API Versioning -->
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <!-- Authentication -->
    <PackageVersion Include="Duende.AccessTokenManagement.OpenIdConnect" Version="4.1.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <!-- Reverse proxy -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- Dependency Injection -->
    <PackageVersion Include="QueryKit" Version="1.16.1" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="Ardalis.SmartEnum" Version="8.2.0" />
    <!-- Caching -->
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.5.0" />
    <!-- Entrypoints: gRPC and MCP -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageVersion Include="Grpc.StatusProto" Version="2.84.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!-- Microsoft Extensions -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.13" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
    <!-- Source Generators -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <!-- Serilog -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Expressions" Version="5.0.0" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <!-- Testing -->
    <PackageVersion Include="TUnit" Version="1.75.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="AutoBogusLifesupport" Version="2.14.0" />
    <PackageVersion Include="Bogus" Version="35.6.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.0" />
    <PackageVersion Include="WebMotions.Fake.Authentication.JwtBearer" Version="10.0.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <!-- Transitive pins: versions of packages that other packages bring in -->
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL and EFCore.NamingConventions: keep Relational at the EF Core version.
         Without the pin, projects that reference the server get 10.0.12 from
         Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore, because EF Core Design is private there. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <!-- Aspire.Hosting and StreamJsonRpc: GHSA-qhrr-8q5h-9q3h -->
    <PackageVersion Include="MessagePack" Version="2.5.303" />
    <!-- Microsoft.EntityFrameworkCore.Design (through MSBuild): GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>