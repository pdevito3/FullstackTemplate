+// 60 characters, as in `<session id>-<name>-0-0-pwnetcopy-1.network`. So a long name keeps its start and gets a hash
+// of the full name, which keeps it short, unique, and the same on each run (vitest-dev/vitest#11880).
+function boundFileName(name) {
+	if (name.length <= 100) return name;
+	let hash = 2166136261;
+	for (let i = 0; i < name.length; i++) hash = Math.imul(hash ^ name.charCodeAt(i), 16777619);
