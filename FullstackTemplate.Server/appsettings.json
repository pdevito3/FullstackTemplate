{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        // gRPC logs the detail of each error status at Information, and the detail can hold text that the caller typed
        "Grpc": "Warning",
        "System": "Warning",
        "ZiggyCreatures.Caching.Fusion": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          // An object, not a string, so that appsettings.Development.json can replace the type
          "formatter": {
            "type": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "FullstackTemplate.Server",
      "Environment": "Production"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    // gRPC needs HTTP/2. Without TLS, Kestrel serves HTTP/2 only on an endpoint that serves only HTTP/2 (h2c).
    // So "grpc" serves only HTTP/2, and "http" keeps HTTP/1.1 for the HTTP API, MCP, and the health checks.
    // In development, Aspire reads these named endpoints and replaces each Url.
    "Endpoints": {
      "http": { "Url": "http://+:8080" },
      "grpc": { "Url": "http://+:8081", "Protocols": "Http2" }
    }
  },
  "Tenancy": {
    // The client IDs of the machine clients that can read the rows of all tenants, with no right to change them
    "ReadAllTenantsClientIds": [],
    // The client IDs of the machine clients that can add tenants and manage any tenant. They also read all rows.
    "ManageAllTenantsClientIds": []
  }
}
